pipeline {
    agent any

    environment {
        IMAGE_NAME = 'abimbola1994/java-calc'
        DOCKER_HUB_CREDENTIALS = 'docker-hub-creds'
        KUBECONFIG_CREDENTIALS_ID = 'kubeconfig-secret'
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'project-3', url: 'https://github.com/Abimbola-star/proj-mdp-152-155.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:${TAG}")
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_HUB_CREDENTIALS) {
                        dockerImage.push("${TAG}")
                        dockerImage.push("latest")
                    }
                }
            }
        }

           stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: "${KUBECONFIG_CREDENTIALS_ID}", variable: 'KUBECONFIG')]) {
                    sh '''
                        export KUBECONFIG=$KUBECONFIG
                        kubectl apply -f k8s/deployment.yml
                        kubectl apply -f k8s/service.yml
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Calculator app built, pushed, and deployed to Kubernetes"
        }
        failure {
            echo "❌ Build or deployment failed. Check logs."
        }
    }
}










